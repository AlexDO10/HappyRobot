# Shared API key the HappyRobot agent sends in the `x-api-key` header.
API_KEY=

# FMCSA carrier verification: mock | live
FMCSA_MODE=mock

# Server-side FMCSA QCMobile webkey (only used when FMCSA_MODE=live).
FMCSA_WEBKEY=

# Comma-separated browser origins allowed to call the API (the dashboard).
# Local dev + your deployed Vercel URL, e.g.:
# DASHBOARD_ORIGINS=http://localhost:5173,https://your-dashboard.vercel.app
DASHBOARD_ORIGINS=http://localhost:5173

# SQLite path for call-results analytics (on Fly this points at the volume).
CALLS_DB=data/calls.db
